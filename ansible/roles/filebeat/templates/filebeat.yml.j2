filebeat.inputs:
  # System logs
  - type: log
    enabled: true
    paths:
      - /var/log/syslog
      - /var/log/auth.log
      - /var/log/kern.log
    fields:
      log_type: system
      hostname: {{ ansible_hostname }}
    fields_under_root: false
    multiline.pattern: '^\s'
    multiline.negate: false
    multiline.match: after

  # Application logs (Flask apps) - JSON format, no multiline needed
  - type: log
    enabled: true
    paths:
      - /var/log/flask_apps/*.log
      - /home/devops/flask_app/*.log
    fields:
      log_type: application
      hostname: {{ ansible_hostname }}
    fields_under_root: false
    json.keys_under_root: true
    json.add_error_key: true

  # Docker container logs - JSON format, no multiline needed
  - type: log
    enabled: true
    paths:
      - /var/lib/docker/containers/*/*.log
    fields:
      log_type: docker
      hostname: {{ ansible_hostname }}
    fields_under_root: false
    json.keys_under_root: true
    json.add_error_key: true

# Processors to add metadata
processors:
  - add_host_metadata:
      when.not.contains.tags: forwarded
  # Note: Docker metadata processor removed to avoid failures on VMs without Docker
  # It can be added conditionally later if needed

# Output to Logstash
output.logstash:
  hosts: ["192.168.56.25:5044"]
  # Optional: Enable SSL/TLS if configured in Logstash
  # ssl.certificate_authorities: ["/etc/filebeat/ca.crt"]

# Logging configuration
logging.level: info
logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644

# Setup template (optional, if using Elasticsearch directly)
setup.template.enabled: false

